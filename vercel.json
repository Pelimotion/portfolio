{
  "outputDirectory": ".",
  "redirects": [
    { "source": "/v1", "destination": "/v1/", "permanent": true },
    { "source": "/curriculum", "destination": "/curriculum/", "permanent": true },
    { "source": "/curriculum/private", "destination": "/curriculum/private/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/v1/", "destination": "/legacy/V1/portfolio/index.html" },
    { "source": "/v1/:path*", "destination": "/legacy/V1/portfolio/:path*" },
    { "source": "/portfolio", "destination": "/legacy/V1/portfolio/index.html" },
    { "source": "/portfolio/:path*", "destination": "/legacy/V1/portfolio/index.html" },
    { "source": "/curriculum", "destination": "/Curriculum/index.html" },
    { "source": "/curriculum/:path*", "destination": "/Curriculum/:path*" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/projetos/assets/:path*", "destination": "/projetos-app/dist/assets/:path*" },
    { "source": "/projetos", "destination": "/projetos-app/dist/index.html" },
    { "source": "/projetos/:match*", "destination": "/projetos-app/dist/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/blog/assets/:path*", "destination": "/blog/assets/:path*" },
    { "source": "/en/blog", "destination": "/en/blog/index.html" },
    { "source": "/en/blog/:slug", "destination": "/en/blog/:slug.html" }
  ]
}
