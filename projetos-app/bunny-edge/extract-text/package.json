{
  "name": "extract-text-edge",
  "version": "1.0.0",
  "private": true,
  "description": "Bunny Edge Script — extração de texto de arquivos Google Drive",
  "scripts": {
    "build": "esbuild index.js --bundle --platform=browser --target=es2022 --outfile=dist/index.js --minify",
    "build:check": "ls -lh dist/index.js && echo 'Limite: 1MB'",
    "build:full": "npm run build && npm run build:check"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18"
  }
}
