# Spike K.1 — Document Intelligence
# Copiar este arquivo para .env.spike e preencher os valores reais.
# NUNCA commitar .env.spike — ele já está no .gitignore.

# Service role key do Supabase (bypassa RLS — seguro apenas para scripts locais)
# Painel: https://supabase.com/dashboard/project/gfaqnkmmbozmhroicqyc/settings/api
# Seção: Project API Keys → service_role (reveal)
SUPABASE_SERVICE_KEY=

# Token OAuth Google com escopo drive.readonly
# Gerar via: https://developers.google.com/oauthplayground/
# Step 1: selecionar "Drive API v3" → https://www.googleapis.com/auth/drive.readonly
# Step 2: clicar "Authorize APIs" → Step 3: "Exchange authorization code for tokens"
# Copiar o "Access token" (válido por ~1 hora)
GDRIVE_ACCESS_TOKEN=

# UUID do projeto na tabela `pages` do Supabase
# Buscar no Supabase Table Editor → pages → coluna id (de um projeto real com docs no Drive)
PROJECT_ID=

# ID da pasta raiz no Google Drive (a que você conectou no AssetsPanel do projeto)
# Extrair da URL: drive.google.com/drive/folders/ESTE_ID_AQUI
ROOT_FOLDER_ID=

# (Opcional) URL do Edge script se já deployado — deixar vazio para usar Drive API direto
EXTRACT_TEXT_URL=
