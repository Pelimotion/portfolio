# ============================================
# wide-image-studio — variáveis de ambiente
# ============================================
# Estas variáveis são configuradas no painel Bunny Edge Scripting
# (Settings → Environment Variables) e NUNCA commitadas.

# --- Higgsfield ---
# Obter em: https://cloud.higgsfield.ai/api-keys
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
HF_SECRET=sk_xxxxxxxxxxxxxxxxxxxx
# Formato unificado v2 (alternativa): HF_CREDENTIALS=hf_xxx:sk_xxx
# HF_CREDENTIALS=

# --- Webhook secret (gerar com: openssl rand -hex 32) ---
WEBHOOK_SECRET=

# --- Supabase ---
# Service Role Key (não anon) — usada apenas no edge script para bypass RLS no webhook
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public anon key — para validar JWTs de usuários
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS / Roteamento ---
# Onde o frontend está hospedado (para CORS allow-origin)
ALLOWED_ORIGIN=https://studio.pelimotion.com
# URL pública do edge script (usada para webhook callback)
PUBLIC_EDGE_URL=https://pelimotion.com/wide-api

# --- Defaults (override no brief se necessário) ---
DEFAULT_MASTER_MODEL=seedream-5-lite
DEFAULT_TILE_MODEL=nano-banana-pro
DEFAULT_TILE_RESOLUTION=4096x1755
DEFAULT_OVERLAP_PCT=0.35

# --- Limites operacionais ---
MAX_REFS_PER_JOB=5
MAX_CONCURRENT_JOBS_PER_USER=2
JOB_TIMEOUT_MINUTES=15
